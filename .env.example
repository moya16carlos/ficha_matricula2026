# Copia este archivo como .env y rellena los valores reales.
# Nunca subas el .env real a control de versiones.

# Genera una clave fuerte con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave

# 'True' solo en desarrollo
DJANGO_DEBUG=False

# Motor: django.db.backends.mysql (prod/docker) o django.db.backends.sqlite3 (local)
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

ALLOWED_HOSTS=127.0.0.1,localhost,ficha.liceosp.cl
CSRF_TRUSTED_ORIGINS=https://ficha.liceosp.cl
SECURE_COOKIES=True
